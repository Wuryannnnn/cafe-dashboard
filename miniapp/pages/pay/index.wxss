.wrap {
  display: flex; flex-direction: column; align-items: center;
  padding-top: 200rpx; text-align: center;
}
.title { font-size: 34rpx; font-weight: 600; margin-top: 32rpx; }
.sub { font-size: 24rpx; margin-top: 12rpx; }

.spinner {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  border: 6rpx solid #e7e5e4; border-top-color: #6b4226;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.icon-fail {
  width: 96rpx; height: 96rpx; line-height: 96rpx; border-radius: 50%;
  background: #fee2e2; color: #b91c1c; font-size: 56rpx; font-weight: 700;
}
.action { padding: 22rpx 80rpx; font-size: 30rpx; margin-top: 56rpx; }
.link { font-size: 26rpx; margin-top: 28rpx; text-decoration: underline; }
