.wrap { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; }

.card {
  width: 560rpx; background: #fff; border-radius: 28rpx;
  padding: 56rpx 0; display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}
.label { font-size: 24rpx; }
.pickup { font-size: 120rpx; font-weight: 800; color: #6b4226; line-height: 1.1; margin: 8rpx 0 24rpx; }

.status {
  padding: 10rpx 36rpx; border-radius: 999rpx;
  font-size: 28rpx; font-weight: 600;
  background: #f5f5f4; color: #57534e;
}
.status-1 { background: #fef3c7; color: #b45309; }
.status-2 { background: #dcfce7; color: #15803d; }
.status-3 { background: #e0e7ff; color: #4338ca; }
.status-4, .status-5 { background: #fee2e2; color: #b91c1c; }

.amount { font-size: 24rpx; margin-top: 24rpx; }

.hint { margin-top: 40rpx; font-size: 28rpx; }
.hint.highlight { color: #15803d; font-weight: 600; }

.link { font-size: 26rpx; margin-top: 64rpx; text-decoration: underline; }
